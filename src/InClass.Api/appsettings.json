{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  },
  "Storage": {
    "PrimaryProvider": "FileStorage",
    "EnableFallback": true,
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "hotelplatform",
      "CreateContainerIfNotExists": true
    },
    "LocalStorage": {
      "BasePath": "uploads",
      "BaseUrl": "/files"
    },
    "Validation": {
      "MaxFileSizeBytes": 10485760,
      "AllowedContentTypes": [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/webp"
      ],
      "AllowedExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp"
      ]
    }
  }
}
